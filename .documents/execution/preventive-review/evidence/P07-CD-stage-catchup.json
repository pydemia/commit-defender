              "reason": "Anchor matches a non-truncated source read. This does not prove the finding."
            },
            "evidenceAssessment": {
              "level": "source-confirmed",
              "rationale": "Source-confirmed regression: the fixed base supplies 0, whereas the current implementation invokes reduce without an initial value, which throws on an empty array.",
              "conditions": [
                "sum receives an empty array, including through emptyTotal()."
              ],
              "evidenceIds": [
                "3f74264b-837a-4267-9ec3-c5d2383ec218",
