# commit-defender — example env file
#
# Copy this file to a private location (e.g. ~/.commit-defender.env) and
# point the VS Code setting `commitDefender.envFile` at it. Values here
# are loaded as CD_* environment variables.
#
# VS Code settings (User/Workspace) take precedence over env-file values
# when both are set. Keep secrets (CD_API_KEY) out of source control —
# this file is an example only.

# ── AI connection ─────────────────────────────────────────────────────────

# Provider: aoai | anthropic | openai | gemini
CD_AI_PROVIDER=aoai

# Model or Azure deployment name. Examples per provider:
#   aoai      → your Azure deployment name (e.g. gpt-4o-mini-deploy)
#   anthropic → claude-sonnet-4-6, claude-opus-4-7
#   openai    → gpt-4o, o3, o4-mini
#   gemini    → gemini-2.5-pro, gemini-2.5-flash
CD_MODEL=

# API endpoint URL. Required for aoai. For others, leave empty to use the
# default public endpoint (shown below as reference).
#
#   aoai      → https://YOUR_RESOURCE.openai.azure.com
#   anthropic → https://api.anthropic.com/v1
#   openai    → https://api.openai.com/v1
#   gemini    → https://generativelanguage.googleapis.com/v1beta/models
CD_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com

# Used by aoai only. Ignored for other providers.
CD_API_VERSION=2024-08-01-preview

# Provider API key. Treat as a secret — do NOT commit.
CD_API_KEY=

# Maximum output tokens for the AI review response. Increase if you see
# "Could not parse AI response as JSON" on large diffs.
CD_MAX_TOKENS=4096

# ── Review behaviour (optional — VS Code settings cover these) ────────────

# CD_ANALYSIS_MODE=hybrid              # hybrid | ai-powered | rule-based
# CD_SEVERITY_LEVEL=moderate           # severe | rigorous | moderate | generous | lean
# CD_RICHNESS_LEVEL=moderate           # colorful | chatty | moderate | simple | silent
# CD_LOCALE=en                         # en | ko
# CD_EXCLUDE_PATTERNS=tests/**,*.generated.ts

# ── Many-files guard (pre-commit hook only — VS Code handles its own UI) ──

# CD_STAGED_FILES_WARN_THRESHOLD=20
# CD_REPO_ANALYSIS_WARN_THRESHOLD=80
# CD_MANY_FILES_ACTION=                # proceed | skip | abort  (empty = prompt)
